# .env untuk seluruh stack (dipakai oleh docker-compose.yml di root ini).
# Salin ke ".env" lalu isi nilainya, JANGAN di-commit ke git.

TZ=Asia/Jakarta

# --- Uptime Kuma ---
# Kredensial login dashboard Kuma, dipakai backend untuk konek via Socket.IO.
KUMA_USERNAME=
KUMA_PASSWORD=

# --- Backend perantara (kuma-status-backend) ---
# Isi kalau endpoint /api/* mau diproteksi header "x-api-key".
API_KEY=
# Origin yang boleh akses (CORS). Pisahkan dengan koma kalau lebih dari satu.
CORS_ORIGIN=*

# --- MariaDB ---
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=
