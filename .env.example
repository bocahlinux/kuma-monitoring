# .env untuk seluruh stack (dipakai oleh docker-compose.yml di root ini).
# Salin ke ".env" lalu isi nilainya, JANGAN di-commit ke git.

TZ=Asia/Jakarta

# --- Uptime Kuma ---
# Kredensial login dashboard Kuma, dipakai backend untuk konek via Socket.IO.
KUMA_USERNAME=
KUMA_PASSWORD=

# --- Backend perantara (kuma-status-backend) ---
# Isi kalau endpoint /api/* mau diproteksi header "x-api-key" (opsional, buat
# script/curl/integrasi lain -- panel /admin sendiri pakai login username+password).
API_KEY=
# Origin yang boleh akses (CORS). Pisahkan dengan koma kalau lebih dari satu.
CORS_ORIGIN=*

# --- Login admin (username + password) ---
# Dipakai SEKALI SAJA saat tabel users masih kosong, buat bikin akun admin pertama.
# Setelah user pertama ada, ganti username/password lewat panel /admin (menu "Kelola
# User"), bukan lewat variabel ini -- env ini nggak disinkron ulang tiap restart.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set "true" kalau backend/frontend HANYA diakses lewat HTTPS (mis. domain publik di
# belakang Cloudflare). Kalau juga diakses langsung lewat IP Tailscale via HTTP biasa
# (lihat docker-compose.yml), biarkan "false" -- kalau "true" di situasi itu, cookie
# sesi nggak akan pernah kekirim balik ke server dan login gagal terus.
COOKIE_SECURE=false

# --- MariaDB ---
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Frontend (status page publik) ---
# Di-bake ke file statis SAAT BUILD -- ganti nilainya butuh rebuild ulang:
# docker compose up -d --build frontend
# KOSONGKAN FRONTEND_API_BASE_URL -- nginx di frontend reverse-proxy ke backend lewat
# docker network internal (lihat frontend/nginx.conf), backend tidak expose domain sendiri.
FRONTEND_API_BASE_URL=
FRONTEND_HOME_TITLE=Status Layanan
FRONTEND_HOME_DESCRIPTION=Status realtime layanan kami
FRONTEND_POLL_INTERVAL_MS=20000
FRONTEND_UPTIME_PERIOD_KEY=24
FRONTEND_HEADLINE_PERIOD_KEY=720
FRONTEND_HEADLINE_PERIOD_LABEL=30 hari
