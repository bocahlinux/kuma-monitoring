# Semua variabel di sini WAJIB diawali VITE_ dan di-bake ke bundle statis saat build
# (bukan dibaca saat runtime) -- ini konsekuensi dari Vite/React sebagai static site.

# Base URL backend (tanpa trailing slash). Kosongkan kalau frontend & backend
# satu domain/path yang sama (pakai relative fetch).
VITE_API_BASE_URL=https://kuma-status.samsatkalteng.com

# Slug status page yang mau ditampilkan (dari POST /api/status-pages)
VITE_STATUS_PAGE_SLUG=samsat

# Interval polling ke backend, dalam milidetik
VITE_POLL_INTERVAL_MS=20000

# Key periode uptime yang ditampilkan sebagai badge persentase.
# Cek response GET /api/status-pages/:slug -> monitors[].live.uptime buat lihat
# key apa saja yang tersedia dari Kuma (biasanya "24" = 24 jam terakhir).
VITE_UPTIME_PERIOD_KEY=24
