# --- Backend server ---
PORT=4000
# Bebas dikosongkan saat dev di jaringan lokal, tapi wajib diisi kalau backend ini
# nanti diakses dari luar / internet. Kalau diisi, semua endpoint /api/* wajib
# kirim header "x-api-key" dengan nilai yang sama. Ini opsional/tambahan -- panel
# /admin sendiri pakai login username+password (lihat ADMIN_USERNAME di bawah).
API_KEY=

# Origin yang boleh akses (untuk CORS). Pisahkan dengan koma kalau lebih dari satu.
# Contoh: https://status.contohdomain.com,http://localhost:5173
CORS_ORIGIN=*

# --- Login admin (username + password) ---
# Dipakai SEKALI SAJA saat tabel users masih kosong, buat bikin akun admin pertama.
# Setelah user pertama ada, ganti username/password lewat panel /admin (menu "Kelola
# User"), bukan lewat variabel ini -- env ini nggak disinkron ulang tiap restart.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set "true" kalau backend HANYA diakses lewat HTTPS. Kalau juga diakses langsung
# lewat IP lokal/Tailscale via HTTP biasa, biarkan "false" -- kalau "true" di situasi
# itu, cookie sesi nggak akan pernah kekirim balik ke server dan login gagal terus.
COOKIE_SECURE=false

# --- Koneksi ke Uptime Kuma ---
# Dev lokal (di luar Docker), pakai IP LAN host Kuma:
KUMA_BASE_URL=http://192.168.168.200:3001
# Kalau jalan sebagai container di docker-compose yang sama dengan Kuma (satu network
# "monitoring-network"), ganti ke nama service container-nya:
# KUMA_BASE_URL=http://uptime-kuma:3001
KUMA_USERNAME=
KUMA_PASSWORD=

# --- Database custom status page (SQLite) ---
DB_PATH=./data/app.db
